# ============================================================
# GuineaPig Backend — Environment Configuration Template
# ============================================================
# Copy this file to `.env` (or `.env.development` / `.env.production`) and fill in your values.
#   cp .env.example .env
# ============================================================

# ---------- Redis ----------
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=your-redis-password

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# ---------- S3 / MinIO ----------
S3_BUCKET=guineapig
S3_REGION=default
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ---------- AI Agent ----------
AIAGENT_BASE_URL=http://127.0.0.1:8000

# ---------- Admin ----------
ADMIN_TOKEN=your-admin-token

# ---------- Inner ----------
# 内部服务回调令牌：backend 的 /inner/api/v1/* 路由校验 X-Inner-Token（fail-closed）。
# 需与 aiagent 的 INNER_TOKEN 保持一致（RAG embed 进度回调、记忆内容更新回调依赖）。
INNER_TOKEN=your-inner-token
