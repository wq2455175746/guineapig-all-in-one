# ============================================================
# GuineaPig AI Agent — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# ============================================================

# ---------- Logging ----------
PROJ_LOG_LEVEL=INFO
SYNC_THREAD_COUNT=2

# ---------- Security / Auth ----------
# 接口鉴权令牌：所有受保护端点需携带 X-Admin-Token 或 Authorization: Bearer 请求头。
# 为空时鉴权中间件 fail-closed，除 /health、/docs、/openapi.json、/redoc 外全部拒绝。
ADMIN_TOKEN=your-admin-token
# CORS 允许的来源：dev 默认 ["*"]；prod 必须用 JSON 数组显式配置（不允许通配）。
# CORS_ORIGINS=["https://example.com","https://api.example.com"]

# ---------- LLM (DeepSeek / OpenAI compatible) ----------
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

# ---------- Object Storage (MinIO / S3 compatible) ----------
OSS_AK=your-access-key
OSS_SK=your-secret-key
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_BUCKET=guineapig

# ---------- ASR & TTS ----------
ASR_API_URL=http://127.0.0.1:9991/v1/audio/transcriptions
TTS_API_URL=http://127.0.0.1:9992/inference_zero_shot

# ---------- RAG (Milvus) ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
BACKEND_BASE_URL=http://127.0.0.1:6880

# ---------- Network Search ----------
SEARXNG_URL=http://127.0.0.1:8484

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ---------- Langfuse (LLM Trace 追踪) ----------
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_BASE_URL=http://your-langfuse-host:13000
LANGFUSE_ENABLE=true
